# Copy to $HERMES_HOME/.env and fill in. Never commit the filled file.
ANTHROPIC_API_KEY=            # use a fresh key with its own expiry
TELEGRAM_BOT_TOKEN=           # from @BotFather
TELEGRAM_USER_ID=             # your numeric id (send /start to @userinfobot)
# Optional, only if you enable the gdrive server in config.yaml
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
